# Copy to .env and fill in. .env is gitignored; nothing here is ever sent anywhere
# except the API of whichever provider a given message's model belongs to.

# Required for the chat panel, "Define", and region-capture questions to use any
# Claude model. Without it the reader still works and the Claude Code sidebar
# still reads everything.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Set this too and the chat panel's model picker also offers GPT models
# (see server/models.js for the exact list). Leave unset to stick to Claude only.
# OPENAI_API_KEY=sk-...

# Optional. Which model answers when a request doesn't name one. Defaults to claude-opus-5.
# BOOK_READER_MODEL=claude-sonnet-5

# Optional. Defaults to 4321.
# PORT=4321
