# Copy to .env and fill in. .env is gitignored; nothing here is ever sent anywhere
# except api.anthropic.com when you use the in-app chat.

# Required for the chat panel, "Define", and region-capture questions inside the app.
# Without it the reader still works and the Claude Code sidebar still reads everything.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-opus-5.
# BOOK_READER_MODEL=claude-sonnet-5

# Optional. Defaults to 4321.
# PORT=4321
